{
  "name": "agent-review-lab",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.7"
  },
  "scripts": {
    "dev": "bun run --parallel --filter '@agent-review-lab/*' dev",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write ."
  }
}
